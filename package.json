{
  "name": "@local/workspace-running-monitor",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "Monitor running, pending, and recently ended DSH sessions by workspace.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Xuermosi/workspace-running-monitor.git"
  },
  "homepage": "https://github.com/Xuermosi/workspace-running-monitor#readme",
  "bugs": {
    "url": "https://github.com/Xuermosi/workspace-running-monitor/issues"
  },
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "LICENSE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
